# ── GCP / Vertex AI 설정 ────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=datahub-478802
VERTEX_AI_LOCATION=us-east5
VERTEX_AI_MODEL=claude-sonnet-4-6@default

# 서비스 계정 키 경로 (Ubuntu 서버 기준)
# SCP 업로드: scp service-account-key.json ubuntu@<서버IP>:/opt/sementica/
GOOGLE_APPLICATION_CREDENTIALS=/opt/sementica/service-account-key.json

# ── Notion 설정 ──────────────────────────────────────────────────────────────
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Qdrant 설정 (Docker 로컬) ────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── FalkorDB 설정 (Docker 로컬) ──────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# ── 작업 결과 알림 (메일) ─────────────────────────────────────────────────────
# 인제스트·동기화·백업이 끝날 때 결과를 보냅니다. **성공해도 보냅니다** —
# 실패에만 보내면 "메일이 안 왔다" 가 "잘 돌았다" 와 "아예 안 돌았다" 를
# 모두 뜻하게 되어 구분할 수 없습니다.
# 설정이 없으면 조용히 넘어갑니다 (알림 때문에 파이프라인이 멈추지 않습니다).
#   확인: python src/ops/notify.py --test
ALERT_EMAIL_TO=seongin@joycity.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
# SMTP_SSL=1          # 465 포트(SMTPS)를 쓸 때
# ALERT_ON_SUCCESS=0  # 실패에만 받고 싶을 때
