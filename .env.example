# ── GCP / Vertex AI 설정 ────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=datahub-478802
VERTEX_AI_LOCATION=us-east5
VERTEX_AI_MODEL=claude-sonnet-4-6@default

# 서비스 계정 키 경로 (Ubuntu 서버 기준)
# SCP 업로드: scp service-account-key.json ubuntu@<서버IP>:/opt/sementica/
GOOGLE_APPLICATION_CREDENTIALS=/opt/sementica/service-account-key.json

# ── Notion 설정 ──────────────────────────────────────────────────────────────
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Qdrant 설정 (Docker 로컬) ────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── FalkorDB 설정 (Docker 로컬) ──────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
