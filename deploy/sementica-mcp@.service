# systemd 템플릿 서비스 — 본부별 MCP 인스턴스
# 배포 위치: /etc/systemd/system/sementica-mcp@.service
#
# ⚠️  현재 운영 서버에는 템플릿이 아니라 `sementica-mcp.service`(고정 이름)가
#     설치돼 있습니다. 이 파일은 본부를 여럿 띄울 때를 위한 것이고, 지금
#     돌고 있는 것과는 별개입니다. 실제 배포본은 deploy/README.md 참고.
#
# 사용법:
#   sudo systemctl enable --now sementica-mcp@strategic
#   sudo systemctl enable --now sementica-mcp@dev
#   sudo systemctl enable --now sementica-mcp@platform
#
# 상태 확인:
#   sudo systemctl status sementica-mcp@strategic
#
# 포트는 departments.yaml의 mcp_port 값을 따릅니다:
#   strategic → 8765
#   dev       → 8766
#   platform  → 8767

[Unit]
Description=Semantica MCP Server (%i)
After=network.target falkordb.service qdrant.service
Wants=falkordb.service qdrant.service

[Service]
Type=simple
User=seongin
WorkingDirectory=/home/seongin/sementica
EnvironmentFile=/home/seongin/sementica/.env

ExecStart=/home/seongin/sementica/.venv/bin/python \
    src/mcp/server.py \
    --dept %i \
    --transport streamable-http

Restart=always
RestartSec=10
# systemd 아래에서는 stdout 이 블록 버퍼링됩니다. 그대로 두면 print()
# 출력이 프로세스 종료 시점에 한꺼번에 나와, 로그에서 배너가 에러보다
# 뒤에 찍힙니다 — 장애 원인을 잘못 짚기 딱 좋습니다.
Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal

# 메모리 제한 (본부당)
MemoryMax=1G

[Install]
WantedBy=multi-user.target
