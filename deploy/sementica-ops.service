[Unit]
Description=Semantica Ops Web Dashboard
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=seongin
WorkingDirectory=/home/seongin/sementica
EnvironmentFile=/home/seongin/sementica/.env
# 바인딩 주소는 --host 로 박지 않고 .env 의 OPS_HOST 로 정합니다.
# 유닛에 박아두면 바꿀 때마다 root 로 /etc/systemd/system 을 고쳐야 합니다.
#
#   (미설정)          127.0.0.1  — 기본. SSH 터널로만 접근
#   OPS_HOST=0.0.0.0             — 외부 노출. **방화벽이 유일한 방어선입니다**
#
# 이 대시보드에는 인증이 없습니다. /api/batch/run 의 confirm 필드는 오조작
# 방지지 인증이 아니므로, 노출한다면 접근 IP 를 반드시 좁히세요.
ExecStart=/home/seongin/sementica/.venv/bin/python src/ops/web_app.py
Restart=on-failure
RestartSec=5
# systemd 아래에서는 stdout 이 블록 버퍼링됩니다. 그대로 두면 print()
# 출력이 프로세스 종료 시점에 한꺼번에 나와, 로그에서 배너가 에러보다
# 뒤에 찍힙니다 — 장애 원인을 잘못 짚기 딱 좋습니다.
Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sementica-ops

# 외부 직접 노출 없이 nginx reverse proxy 경유
# GCP 방화벽: 8080 포트는 내부(127.0.0.1)만 바인딩

[Install]
WantedBy=multi-user.target
