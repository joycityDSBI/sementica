# logrotate 설정 — cron 로그가 무한히 커지는 것을 막습니다
# 배포 위치: /etc/logrotate.d/sementica
#
#   sudo cp deploy/logrotate-sementica /etc/logrotate.d/sementica
#   sudo logrotate -d /etc/logrotate.d/sementica    # 점검 (실제 회전 없음)
#   sudo logrotate -f /etc/logrotate.d/sementica    # 강제 1회 실행
#
# 대상은 **cron 이 만드는 로그만** 입니다. MCP·REST·Ops 는 systemd 로 옮겨
# journald 가 관리하므로 여기 넣으면 안 됩니다 (journald 는 자체 보존 정책을
# 따르고, 파일이 아니라서 logrotate 대상이 아닙니다).
#
# journald 쪽 용량이 걱정되면 그건 별도 설정입니다:
#   /etc/systemd/journald.conf 의 SystemMaxUse= (예: 500M)
#
# 경로가 계정에 따라 다릅니다. 다른 계정에 설치하면 아래 경로도 바꾸세요.

/home/seongin/sementica/data/logs/*.log {
    # 주 단위로 회전하되, 그 전에라도 50M 을 넘으면 회전합니다.
    # 인제스트 한 번이 수 MB 를 남기므로 크기 조건이 실질적인 방어선입니다.
    weekly
    maxsize 50M
    rotate 8
    compress
    delaycompress

    # 로그가 아직 없을 수 있습니다 (신규 설치, 또는 cron 이 한 번도 안 돎).
    # 그때 logrotate 가 오류를 내지 않도록 합니다.
    missingok
    notifempty

    # 회전 후 새 파일을 만들어 둡니다. cron 작업은 `>>` 로 추가하므로
    # 파일이 없어도 만들어지지만, 권한을 명시해 두는 편이 안전합니다.
    create 0640 seongin seongin

    # ⚠️ copytruncate 를 쓰지 않습니다.
    # 이 로그들은 cron 작업이 **실행될 때만** 파일을 열고 끝나면 닫습니다.
    # 프로세스가 파일을 계속 잡고 있지 않으므로 이름을 바꿔도 안전하고,
    # copytruncate 는 복사와 자르기 사이에 쓰인 내용을 잃습니다.
    #
    # 만약 나중에 로그를 계속 열어두는 상주 프로세스를 추가한다면 그때는
    # copytruncate 나 postrotate 시그널이 필요합니다.
}
